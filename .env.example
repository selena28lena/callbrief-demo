# Бесплатный ключ Gemini API: https://aistudio.google.com/apikey
# Без ключа приложение открывается и показывает демо-данные, но не разбирает новые звонки.
GEMINI_API_KEY=

# Модель для анализа. Если она перегружена или упёрлась в лимит, приложение само
# переключится на модель расшифровки.
GEMINI_MODEL=gemini-3.5-flash

# Модель для расшифровки аудио — быстрая и лёгкая.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite

# Необязательно: входящий вебхук Битрикс24 с правами crm, task, user.
# Без него действия уходят во встроенную демо-CRM.
# BITRIX_WEBHOOK_URL=https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxxxxxx/

# Необязательно: прокси VPN-клиента, если Gemini недоступен напрямую.
# HTTPS_PROXY=http://127.0.0.1:10809
