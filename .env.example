# Бесплатный ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель Gemini Flash с бесплатным тарифом.
# Если у модели нет бесплатной квоты (ошибка 429 сразу), попробуйте:
#   gemini-flash-latest  или  gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Необязательно: адрес прокси вашего VPN-клиента, если Gemini недоступен напрямую.
# Например, для v2rayN: HTTPS_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=
